# Core frontend connection
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_public_key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Public tenant resolution
# Example: labs.yourproduct.com
VITE_PUBLIC_BASE_DOMAIN="labs.example.com"
VITE_PUBLIC_LOGO_URL="https://yourproduct.com/logo.png"

# Root/platform branding
VITE_PLATFORM_PRODUCT_NAME="Diagnostic Lab OS"
VITE_PLATFORM_COMPANY_NAME="Diagnostic Lab OS"
VITE_PLATFORM_LABEL="Platform"
VITE_PLATFORM_TAGLINE="Lab management software for diagnostic labs."
VITE_PLATFORM_CONTACT_EMAIL="sales@example.com"

# Public form protection
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAYOURTURNSTILESITEKEY"

# Optional client-side integrations still referenced in the app
VITE_TWILIO_ACCOUNT_SID=""
VITE_TWILIO_AUTH_TOKEN=""
VITE_TWILIO_PHONE_NUMBER=""

# Optional payment/public branding examples
VITE_RAZORPAY_KEY_ID=""

# Public address of the bucket that holds the desktop app installers (Cloudflare R2 custom domain), no trailing slash.
VITE_DOWNLOADS_BASE_URL="https://lims-downloads.labshope.com"
