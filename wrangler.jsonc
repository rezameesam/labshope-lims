{
  // Git-connected deployment of the LabShope LIMS web app (static files built by `npm run build` into ./dist).
  //
  // SAFE BY DEFAULT: a NEW Worker name and NO routes / custom domains here on purpose.
  // The live site is served by the Worker "tight-river-11a4" through a WILDCARD route (*.labshope.com) that carries every
  // lab's subdomain. Putting `routes` in this file would move that traffic the moment it is deployed. Attach domains in
  // the Cloudflare dashboard, in a quiet window, only after testing the workers.dev address (see DEPLOY_CLOUDFLARE.md).
  "name": "labshope-lims-app",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
