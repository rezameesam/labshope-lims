<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.RoleDialog"
        Title="Role" Width="560" Height="700" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" />
        <Button x:Name="SaveButton" Classes="primary" Content="Save role" IsDefault="True" Click="OnSave" Padding="20,9" />
      </StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock x:Name="HeadText" Text="New role" Classes="h2" />
      <TextBox x:Name="NameBox" Watermark="Role name" />
      <TextBox x:Name="DescriptionBox" Watermark="What this role is for (optional)" />
      <CheckBox x:Name="ActiveBox" Content="Role is active" IsChecked="True" />
      <TextBlock Text="What this role may do" FontWeight="SemiBold" Margin="0,6,0,0" />
    </StackPanel>
    <ScrollViewer><StackPanel x:Name="PermissionPanel" Spacing="10" /></ScrollViewer>
  </DockPanel>
</Window>
