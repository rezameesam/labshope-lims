<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.ReminderDialog"
        Title="Reminder" Width="520" Height="600" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8">
      <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" />
        <Button x:Name="SaveButton" Classes="primary" Content="Save reminder" IsDefault="True" Click="OnSave" Padding="20,9" />
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock x:Name="HeadText" Text="New reminder" Classes="h2" />
      <TextBox x:Name="PatientSearch" Watermark="Search patient by name, phone or ID" />
      <ListBox x:Name="PatientResults" MaxHeight="120" />
      <TextBlock x:Name="PickedText" FontWeight="SemiBold" IsVisible="False" />
      <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" />
      <TextBox x:Name="TitleBox" Watermark="Title" />
      <TextBox x:Name="MessageBox" Watermark="Note (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <StackPanel Spacing="4"><TextBlock Text="Remind on (yyyy-mm-dd)" Classes="muted" /><TextBox x:Name="DateBox" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Due by (optional)" Classes="muted" /><TextBox x:Name="DueBox" /></StackPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
