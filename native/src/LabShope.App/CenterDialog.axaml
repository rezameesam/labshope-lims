<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.CenterDialog"
        Title="Collection centre" Width="480" Height="600" CanResize="False" WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="26" Spacing="8">
      <TextBlock x:Name="Heading" Text="Add a collection centre" Classes="h2" />
      <TextBlock Text="LAB" Classes="label" />
      <ComboBox x:Name="LabBox" HorizontalAlignment="Stretch" />
      <Grid ColumnDefinitions="*,12,2*" Margin="0,6,0,0">
        <StackPanel Spacing="4"><TextBlock Text="CODE" Classes="label" /><TextBox x:Name="CodeBox" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="NAME" Classes="label" /><TextBox x:Name="NameBox" /></StackPanel>
      </Grid>
      <TextBlock Text="ADDRESS" Classes="label" Margin="0,6,0,0" />
      <TextBox x:Name="AddressBox" />
      <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
        <StackPanel Spacing="4"><TextBlock Text="CONTACT PERSON" Classes="label" /><TextBox x:Name="ContactBox" /></StackPanel>
        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="PHONE" Classes="label" /><TextBox x:Name="PhoneBox" /></StackPanel>
      </Grid>
      <TextBlock Text="EMAIL" Classes="label" Margin="0,6,0,0" />
      <TextBox x:Name="EmailBox" />
      <CheckBox x:Name="ActiveBox" Content="Active" IsChecked="True" Margin="0,6,0,0" />
      <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="Cancel" Click="OnCancel" />
        <Button x:Name="SaveButton" Classes="primary" Content="Save" IsDefault="True" Click="OnSave" Padding="20,9" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
