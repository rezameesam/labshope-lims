<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:LabShope.Core.Data"
             xmlns:app="using:LabShope.App"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="LabShope.App.RegisterVisitView">
  <Grid ColumnDefinitions="*,18,*">

    <!-- Who and visit details -->
    <ScrollViewer Grid.Column="0">
      <StackPanel Spacing="16">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="Patient" Classes="h2" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ExistingButton" Classes="seg on" Content="Existing patient" Click="OnExistingMode" />
              <Button x:Name="NewButton" Classes="seg" Content="New patient" Click="OnNewMode" />
            </StackPanel>

            <StackPanel x:Name="ExistingPanel" Spacing="8">
              <TextBox x:Name="PatientSearch" Watermark="Search by name, phone or patient ID (or scan the card)" />
              <ListBox x:Name="PatientResults" MaxHeight="200" />
              <Border x:Name="PickedChip" Classes="pill" Background="{StaticResource SuccessBgBrush}" HorizontalAlignment="Left" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="CheckCircle" Width="16" Height="16" Foreground="{StaticResource SuccessBrush}" />
                  <TextBlock x:Name="PickedPatient" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Grid x:Name="NewPanel" IsVisible="False" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Text="Full name" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="NewName" Grid.Column="1" />
              <TextBlock Text="Phone" Classes="muted" Grid.Row="1" VerticalAlignment="Center" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <TextBox x:Name="NewPhone" Watermark="10-digit mobile number" />
                <CheckBox x:Name="NoPhoneBox" Content="No phone number" IsCheckedChanged="OnNoPhoneChanged" />
              </StackPanel>
              <TextBlock Text="Gender" Classes="muted" Grid.Row="2" VerticalAlignment="Center" />
              <ComboBox x:Name="NewGender" Grid.Row="2" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem>male</ComboBoxItem>
                <ComboBoxItem>female</ComboBoxItem>
                <ComboBoxItem>other</ComboBoxItem>
              </ComboBox>
              <TextBlock Text="Date of birth" Classes="muted" Grid.Row="3" VerticalAlignment="Center" />
              <CalendarDatePicker x:Name="NewDob" Grid.Row="3" Grid.Column="1" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" Watermark="dd/mm/yyyy (optional)" HorizontalAlignment="Stretch" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="Visit details" Classes="h2" />
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Text="Referred by" Classes="muted" VerticalAlignment="Center" />
              <ComboBox x:Name="DoctorBox" Grid.Column="1" HorizontalAlignment="Stretch" />
              <TextBlock Text="Collection centre" Classes="muted" Grid.Row="1" VerticalAlignment="Center" />
              <ComboBox x:Name="CenterBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />
              <TextBlock Text="Notes" Classes="muted" Grid.Row="2" VerticalAlignment="Center" />
              <TextBox x:Name="NotesBox" Grid.Row="2" Grid.Column="1" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Tests, payment, save -->
    <Border Grid.Column="2" Classes="card">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,14,0,0">
          <Border Height="1" Background="{StaticResource GridLineBrush}" />
          <TextBlock Text="PAYMENT" Classes="label" />
          <Grid ColumnDefinitions="Auto,100,*" ColumnSpacing="10">
            <TextBlock Text="Discount" Classes="muted" VerticalAlignment="Center" />
            <TextBox x:Name="DiscountBox" Grid.Column="1" Text="0" />
            <TextBlock x:Name="DiscountNote" Grid.Column="2" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
          <Grid ColumnDefinitions="Auto,100,Auto,130,*" ColumnSpacing="10">
            <TextBlock Text="Received now" Classes="muted" VerticalAlignment="Center" />
            <TextBox x:Name="PayAmount" Grid.Column="1" Text="0" />
            <TextBlock Text="by" Classes="muted" Grid.Column="2" VerticalAlignment="Center" />
            <ComboBox x:Name="PayMethod" Grid.Column="3" SelectedIndex="0" HorizontalAlignment="Stretch">
              <ComboBoxItem>cash</ComboBoxItem>
              <ComboBoxItem>upi</ComboBoxItem>
              <ComboBoxItem>card</ComboBoxItem>
              <ComboBoxItem>online</ComboBoxItem>
              <ComboBoxItem>bank_transfer</ComboBoxItem>
            </ComboBox>
            <TextBox x:Name="PayRef" Grid.Column="4" Watermark="Reference" />
          </Grid>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button x:Name="PayFullButton" Content="Paid in full" Click="OnPayFull" Padding="12,6" />
              <Button x:Name="PayLaterButton" Content="Pay later" Click="OnPayLater" Padding="12,6" />
            </StackPanel>
            <TextBlock x:Name="BalanceText" VerticalAlignment="Center" FontWeight="SemiBold" />
          </DockPanel>
          <DockPanel>
            <TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontSize="24" FontWeight="SemiBold" Text="Total 0" />
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="LabelButton" Content="Print labels" Click="OnPrintLabels" IsVisible="False" />
            <Button x:Name="ReceiptButton" Content="Print receipt" Click="OnPrintReceipt" IsVisible="False" />
            <Button x:Name="ClearButton" Content="Clear" Click="OnClear" />
            <Button x:Name="SaveButton" Classes="primary" Content="Save visit (F8)" Click="OnSave" Padding="22,10" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="10">
          <TextBlock Text="Tests" Classes="h2" />
          <ComboBox x:Name="PackageBox" HorizontalAlignment="Stretch" />
          <TextBox x:Name="TestSearch" Watermark="Search tests - Enter adds the highlighted one" />
          <ListBox x:Name="TestResults" MaxHeight="170">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="data:CatalogTest">
                <DockPanel>
                  <TextBlock Text="{Binding Price}" DockPanel.Dock="Right" Classes="muted" />
                  <TextBlock Text="{Binding Name}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="SELECTED  -  Delete removes the highlighted test" Classes="label" Margin="0,6,0,0" />
        </StackPanel>

        <DataGrid x:Name="SelectedGrid" x:DataType="app:SelectedTest" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
          <DataGrid.Columns>
            <DataGridTextColumn Header="TEST" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="PRICE" Binding="{Binding PriceText}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
