<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:LabShope.Core.Data"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="data:Patient"
             x:Class="LabShope.App.PatientRegisterView">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <Grid ColumnDefinitions="Auto,*" MaxWidth="460" HorizontalAlignment="Left">
        <Border Background="White" BorderBrush="#C7D8E1" BorderThickness="1" CornerRadius="8" Grid.ColumnSpan="2" />
        <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" />
        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Width="420" PlaceholderText="Search by name, phone or patient ID" />
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="CountText" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
        <Button x:Name="EditButton" Click="OnEdit"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="AccountEditOutline" Width="17" Height="17" /><TextBlock Text="Edit patient" /></StackPanel></Button>
        <Button x:Name="RegisterButton" Classes="primary" Click="OnRegisterVisit"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="ClipboardPlusOutline" Width="17" Height="17" /><TextBlock Text="Register visit" /></StackPanel></Button>
      </StackPanel>
    </Grid>
    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="PATIENT ID" Binding="{Binding PatientCode}" Width="130" />
        <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="*" />
        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="170" />
        <DataGridTextColumn Header="GENDER" Binding="{Binding Gender}" Width="110" />
        <DataGridTextColumn Header="DATE OF BIRTH" Binding="{Binding BirthDate}" Width="140" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
