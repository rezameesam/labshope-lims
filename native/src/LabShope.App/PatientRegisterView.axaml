<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:LabShope.Core.Data"
             x:DataType="data:Patient"
             x:Class="LabShope.App.PatientRegisterView">
  <DockPanel Margin="6">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Text="Search (name, phone, ID):" VerticalAlignment="Center" />
      <TextBox x:Name="SearchBox" Width="320" />
      <Button x:Name="EditButton" Content="Edit patient" Click="OnEdit" />
      <Button x:Name="RegisterButton" Content="Register visit" Click="OnRegisterVisit" />
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#555" />
    </StackPanel>
    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
              CanUserResizeColumns="True" GridLinesVisibility="All" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientCode}" Width="130" />
        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*" />
        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140" />
        <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="90" />
        <DataGridTextColumn Header="Date of birth" Binding="{Binding DateOfBirth}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
