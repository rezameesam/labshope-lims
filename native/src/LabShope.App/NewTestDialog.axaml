<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.NewTestDialog"
        Title="New test" Width="480" Height="620" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="8">
    <TextBlock Text="Add a test" Classes="h2" />
    <TextBlock Text="The test is added for every computer in the lab and appears at the next sync." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" />
    <TextBlock Text="TEST NAME" Classes="label" />
    <TextBox x:Name="NameBox" />
    <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
      <StackPanel Spacing="4"><TextBlock Text="PRICE" Classes="label" /><TextBox x:Name="PriceBox" /></StackPanel>
      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="SAMPLE" Classes="label" /><TextBox x:Name="SampleBox" Text="Blood" /></StackPanel>
    </Grid>
    <TextBlock Text="CATEGORY" Classes="label" Margin="0,6,0,0" />
    <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" />
    <TextBlock Text="UNIT" Classes="label" Margin="0,6,0,0" />
    <TextBox x:Name="UnitBox" />
    <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
      <StackPanel Spacing="4"><TextBlock Text="NORMAL MIN" Classes="label" /><TextBox x:Name="MinBox" /></StackPanel>
      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="NORMAL MAX" Classes="label" /><TextBox x:Name="MaxBox" /></StackPanel>
    </Grid>
    <TextBlock Text="RANGE TEXT (optional, e.g. 'Negative')" Classes="label" Margin="0,6,0,0" />
    <TextBox x:Name="RangeBox" />
    <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Add test" IsDefault="True" Click="OnSave" Padding="20,9" />
    </StackPanel>
  </StackPanel>
</Window>
