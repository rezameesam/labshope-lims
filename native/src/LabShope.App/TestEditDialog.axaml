<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.TestEditDialog"
        Title="Edit test" Width="460" Height="520" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="8">
    <TextBlock x:Name="Heading" Classes="h2" TextWrapping="Wrap" />
    <TextBlock Text="Changes go to the server and reach every computer at its next sync." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" />
    <TextBlock Text="PRICE" Classes="label" />
    <TextBox x:Name="PriceBox" />
    <TextBlock Text="UNIT" Classes="label" Margin="0,6,0,0" />
    <TextBox x:Name="UnitBox" />
    <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
      <StackPanel Spacing="4"><TextBlock Text="NORMAL MIN" Classes="label" /><TextBox x:Name="MinBox" /></StackPanel>
      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="NORMAL MAX" Classes="label" /><TextBox x:Name="MaxBox" /></StackPanel>
    </Grid>
    <TextBlock Text="RANGE TEXT (optional, e.g. 'Negative')" Classes="label" Margin="0,6,0,0" />
    <TextBox x:Name="RangeBox" />
    <CheckBox x:Name="ActiveBox" Content="Offered to patients (active)" Margin="0,8,0,0" />
    <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save" IsDefault="True" Click="OnSave" Padding="20,9" />
    </StackPanel>
  </StackPanel>
</Window>
