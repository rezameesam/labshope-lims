<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.LabProfileDialog"
        Title="Lab profile" Width="560" Height="720" MinHeight="560" WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="26" Spacing="8">
      <TextBlock Text="Lab profile" Classes="h2" />
      <TextBlock Text="Shown on reports, receipts and your website. Changes reach the other computers at their next sync." Classes="muted" TextWrapping="Wrap" />
      <TextBlock x:Name="LoadText" Classes="muted" Text="Loading…" />
      <StackPanel x:Name="Form" Spacing="8" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
          <Border Width="72" Height="72" CornerRadius="10" BorderBrush="#C7D8E1" BorderThickness="1" ClipToBounds="True" Background="White">
            <Image x:Name="LogoImage" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
            <Button x:Name="LogoButton" Content="Choose a new logo…" Click="OnChooseLogo" HorizontalAlignment="Left" />
            <TextBlock x:Name="LogoText" Classes="muted" Text="JPG, PNG, WebP or SVG, up to 2 MB." TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <TextBlock Text="LAB NAME" Classes="label" Margin="0,8,0,0" />
        <TextBox x:Name="NameBox" />
        <Grid ColumnDefinitions="*,12,*" Margin="0,6,0,0">
          <StackPanel Spacing="4"><TextBlock Text="PHONE" Classes="label" /><TextBox x:Name="PhoneBox" /></StackPanel>
          <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="EMAIL" Classes="label" /><TextBox x:Name="EmailBox" /></StackPanel>
        </Grid>
        <TextBlock Text="WEBSITE" Classes="label" Margin="0,6,0,0" />
        <TextBox x:Name="WebsiteBox" Watermark="https://example.com" />
        <TextBlock Text="TAGLINE" Classes="label" Margin="0,6,0,0" />
        <TextBox x:Name="TaglineBox" />
        <TextBlock Text="REPORT FOOTER TAGLINE" Classes="label" Margin="0,6,0,0" />
        <TextBox x:Name="ReportTaglineBox" />
        <TextBlock Text="REPORT FOOTER NOTE" Classes="label" Margin="0,6,0,0" />
        <TextBox x:Name="FooterNoteBox" AcceptsReturn="True" Height="64" TextWrapping="Wrap" />
      </StackPanel>
      <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="Cancel" Click="OnCancel" />
        <Button x:Name="SaveButton" Classes="primary" Content="Save" IsDefault="True" IsEnabled="False" Click="OnSave" Padding="20,9" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
