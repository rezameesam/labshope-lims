<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="LabShope.App.LoginWindow"
        Icon="/Assets/icon.png"
        Title="LabShope LIMS" Width="900" Height="560" CanResize="False"
        WindowStartupLocation="CenterScreen" Background="White">
  <Grid ColumnDefinitions="380,*">

    <!-- Brand panel -->
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#132639" Offset="0" />
          <GradientStop Color="#0B5F86" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid RowDefinitions="Auto,*,Auto" Margin="40,40,36,36">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="44" Height="44" CornerRadius="13" Background="#0B81B7">
            <mi:MaterialIcon Kind="Flask" Width="24" Height="24" Foreground="White" />
          </Border>
          <TextBlock Text="LabShope" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14">
          <TextBlock Text="Laboratory management that never waits for the internet." Foreground="White" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="32" />
          <TextBlock Text="Register patients, take payments and enter results in a click. Everything works offline and syncs when you are connected." Foreground="#B7CBDA" TextWrapping="Wrap" LineHeight="21" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="9">
          <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#7FD1F0" /><TextBlock Text="Barcode scanners and label printing" Foreground="#D6E4EE" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#7FD1F0" /><TextBlock Text="Same account as the LabShope website" Foreground="#D6E4EE" /></StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Form -->
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="64,0" Spacing="12">
      <TextBlock Text="Welcome back" Classes="h1" FontSize="26" />
      <TextBlock Text="Sign in with the email and password you use on the website." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10" />

      <TextBlock Text="EMAIL" Classes="label" />
      <TextBox x:Name="EmailBox" />
      <TextBlock Text="PASSWORD" Classes="label" Margin="0,6,0,0" />
      <TextBox x:Name="PasswordBox" PasswordChar="●" />

      <StackPanel x:Name="ChoicePanel" IsVisible="False" Spacing="6" Margin="0,6,0,0">
        <TextBlock Text="WHICH LAB?" Classes="label" />
        <ComboBox x:Name="LabChoice" HorizontalAlignment="Stretch" />
      </StackPanel>

      <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
      </Border>

      <Button x:Name="SignInButton" Classes="primary" Content="Sign in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              IsDefault="True" Click="OnSignIn" Margin="0,10,0,0" Padding="0,12" FontSize="14" />
      <TextBlock Text="The first sign-in on a computer needs internet. After that the app opens offline." Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
  </Grid>
</Window>
