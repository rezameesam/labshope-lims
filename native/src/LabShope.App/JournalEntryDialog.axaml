<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.JournalEntryDialog"
        Title="New journal entry" Width="760" Height="640" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" />
        <Button x:Name="SaveButton" Classes="primary" Content="Post entry" IsDefault="True" Click="OnSave" Padding="20,9" />
      </StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Text="New journal entry" Classes="h2" />
      <Grid ColumnDefinitions="*,12,200">
        <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectionChanged="OnKindChanged" />
        <CalendarDatePicker x:Name="DateBox" Grid.Column="2" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" HorizontalAlignment="Stretch" />
      </Grid>
      <TextBlock x:Name="HintText" Classes="muted" />
    </StackPanel>
    <StackPanel x:Name="QuickPanel" DockPanel.Dock="Top" Spacing="8" Margin="0,10,0,0">
      <TextBlock x:Name="FromLabel" />
      <ComboBox x:Name="FromBox" HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding Display}" />
      <TextBlock x:Name="ToLabel" />
      <ComboBox x:Name="ToBox" HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding Display}" />
      <TextBox x:Name="AmountBox" Watermark="Amount" />
      <TextBox x:Name="QuickReferenceBox" Watermark="Reference (optional)" />
    </StackPanel>
    <DockPanel x:Name="CustomPanel" Margin="0,10,0,0" IsVisible="False">
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <TextBox x:Name="DescriptionBox" Watermark="Description" />
        <TextBox x:Name="ReferenceBox" Watermark="Reference (optional)" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
        <Button Content="Add line" Click="OnAddLine" />
        <TextBlock x:Name="TotalsText" VerticalAlignment="Center" />
      </StackPanel>
      <ScrollViewer Margin="0,8,0,0"><StackPanel x:Name="LinesPanel" Spacing="6" /></ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
