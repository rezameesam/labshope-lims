<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:LabShope.Core.Data"
             x:Class="LabShope.App.CashBookView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
      <TextBlock Text="Day:" VerticalAlignment="Center" />
      <CalendarDatePicker x:Name="DayPicker" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" MinWidth="150" />
      <Button Content="Today" Click="OnToday" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,14" Margin="0,14,0,0">
      <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>
    <DataGrid x:Name="Grid" x:DataType="data:PaymentRow" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="80" />
        <DataGridTextColumn Header="BILL NO." Binding="{Binding InvoiceNumber}" Width="190" />
        <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientName}" Width="*" />
        <DataGridTextColumn Header="PAID BY" Binding="{Binding Method}" Width="120" />
        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount}" Width="110" />
        <DataGridTextColumn Header="SENT" Binding="{Binding SyncText}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
