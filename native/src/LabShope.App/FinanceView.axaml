<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fin="using:LabShope.Core.Finance"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="LabShope.App.FinanceView">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button x:Name="TrialButton" Classes="seg on" Content="Trial balance" Click="OnReport" Tag="trial" />
      <Button x:Name="PlButton" Classes="seg" Content="Profit &amp; loss" Click="OnReport" Tag="pl" />
      <Button x:Name="BsButton" Classes="seg" Content="Balance sheet" Click="OnReport" Tag="bs" />
      <Button x:Name="LedgerButton" Classes="seg" Content="Account ledger" Click="OnReport" Tag="ledger" />
      <Button x:Name="ChartButton" Classes="seg" Content="Chart of accounts" Click="OnReport" Tag="chart" />
      <Button x:Name="OutButton" Classes="seg" Content="Outsource" Click="OnReport" Tag="out" />
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="YearButton" Classes="seg on" Content="This financial year" Click="OnPeriod" Tag="year" />
        <Button x:Name="MonthButton" Classes="seg" Content="This month" Click="OnPeriod" Tag="month" />
        <Button x:Name="TodayButton" Classes="seg" Content="Today" Click="OnPeriod" Tag="today" />
        <TextBlock x:Name="RangeText" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Border x:Name="TallyChip" Classes="pill" IsVisible="False">
          <TextBlock x:Name="TallyText" />
        </Border>
        <Button x:Name="PrintButton" Click="OnPrint" IsVisible="False"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="PrinterOutline" Width="17" Height="17" /><TextBlock Text="Print" /></StackPanel></Button>
        <Button x:Name="NewEntryButton" Classes="primary" Click="OnNewEntry"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Plus" Width="17" Height="17" /><TextBlock Text="New entry" /></StackPanel></Button>
        <Button Click="OnRefresh"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Refresh" Width="17" Height="17" /><TextBlock Text="Refresh" /></StackPanel></Button>
      </StackPanel>
    </Grid>

    <Border x:Name="MessageCard" DockPanel.Dock="Top" Classes="card" Background="#FFF8E6" BorderBrush="#F2D488" Margin="0,0,0,16" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <mi:MaterialIcon Kind="CloudOffOutline" Width="20" Height="20" Foreground="{StaticResource WarnBrush}" />
        <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <DockPanel x:Name="StatementPanel" IsVisible="False" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock x:Name="StatementTitle" DockPanel.Dock="Top" Classes="h2" Margin="0,0,0,10" />
      <DataGrid x:Name="StatementGrid" x:DataType="fin:StatementLine" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Code}" Width="80" />
          <DataGridTextColumn Binding="{Binding Label}" Width="*" />
          <DataGridTextColumn Binding="{Binding AmountText}" Width="140" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <TextBlock x:Name="NoticeText" DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,10" IsVisible="False" />
    <DockPanel x:Name="ChartPanel" IsVisible="False">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
        <Button x:Name="AddAccountButton" Content="Add account" Click="OnAddAccount" />
        <Button x:Name="EditAccountButton" Content="Change selected" Click="OnEditAccount" />
        <Button x:Name="ToggleAccountButton" Content="Switch selected on / off" Click="OnToggleAccount" />
        <Button x:Name="SeedButton" Content="Create the default accounts" Click="OnSeed" IsVisible="False" />
      </StackPanel>
      <DataGrid x:Name="ChartGrid" x:DataType="fin:AccountInfo" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="90" />
          <DataGridTextColumn Header="ACCOUNT" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="110" />
          <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
          <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <DockPanel x:Name="LedgerPanel" IsVisible="False">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
        <TextBlock Text="Account" VerticalAlignment="Center" />
        <ComboBox x:Name="AccountPicker" Width="340" x:DataType="fin:AccountInfo" SelectionChanged="OnAccountPicked" DisplayMemberBinding="{Binding Display}" />
        <TextBlock x:Name="LedgerTotals" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
      <DataGrid x:Name="LedgerGrid" x:DataType="fin:LedgerLine" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="100" />
          <DataGridTextColumn Header="ENTRY" Binding="{Binding EntryNumber}" Width="110" />
          <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
          <DataGridTextColumn Header="DEBIT" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="100" />
          <DataGridTextColumn Header="CREDIT" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="100" />
          <DataGridTextColumn Header="BALANCE" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <DockPanel x:Name="OutsourcePanel" IsVisible="False">
      <TextBlock x:Name="OutsourceTotals" DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,10" />
      <DataGrid x:Name="OutsourceLabGrid" DockPanel.Dock="Top" MaxHeight="180" Margin="0,0,0,12" x:DataType="fin:LabSummary" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="OUTSIDE LAB" Binding="{Binding Lab}" Width="*" />
          <DataGridTextColumn Header="TESTS" Binding="{Binding Count}" Width="80" />
          <DataGridTextColumn Header="COST" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="110" />
          <DataGridTextColumn Header="BILLED" Binding="{Binding Revenue, StringFormat={}{0:N2}}" Width="110" />
          <DataGridTextColumn Header="MARGIN" Binding="{Binding Margin, StringFormat={}{0:N2}}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="OutsourceTestGrid" x:DataType="fin:OutsourcedTest" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="100" />
          <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientName}" Width="*" />
          <DataGridTextColumn Header="TEST" Binding="{Binding TestName}" Width="*" />
          <DataGridTextColumn Header="OUTSIDE LAB" Binding="{Binding Lab}" Width="*" />
          <DataGridTextColumn Header="COST" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="100" />
          <DataGridTextColumn Header="BILLED" Binding="{Binding SellPrice, StringFormat={}{0:N2}}" Width="100" />
          <DataGridTextColumn Header="MARGIN" Binding="{Binding Margin, StringFormat={}{0:N2}}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <Grid x:Name="Body" ColumnDefinitions="*,16,*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Trial balance" Classes="h2" Margin="0,0,0,10" />
        <DataGrid x:Name="BalanceGrid" x:DataType="fin:AccountBalance" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="84" />
            <DataGridTextColumn Header="ACCOUNT" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="90" />
            <DataGridTextColumn Header="DEBIT" Binding="{Binding TotalDebit, StringFormat={}{0:N2}}" Width="100" />
            <DataGridTextColumn Header="CREDIT" Binding="{Binding TotalCredit, StringFormat={}{0:N2}}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Recent entries" Classes="h2" Margin="0,0,0,10" />
        <DataGrid x:Name="EntryGrid" x:DataType="fin:JournalLine" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="DATE" Binding="{Binding EntryDate}" Width="100" />
            <DataGridTextColumn Header="ENTRY" Binding="{Binding EntryNumber}" Width="110" />
            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" />
            <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
