<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="LabShope.App.DuplicatePhoneDialog"
        Title="Phone number already registered" Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <mi:MaterialIcon Kind="AlertOutline" Width="24" Height="24" Foreground="{StaticResource WarnBrush}" />
      <TextBlock Text="Phone number already registered" Classes="h2" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="Detail" Classes="muted" TextWrapping="Wrap" />
    <ListBox x:Name="Matches" MaxHeight="200" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Create a new patient anyway" Click="OnCreateNew" />
      <Button x:Name="UseButton" Classes="primary" Content="Use this patient" Click="OnUse" Padding="18,9" />
    </StackPanel>
  </StackPanel>
</Window>
