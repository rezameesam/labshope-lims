<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.ResetPasswordDialog"
        Title="Reset password" Width="480" Height="470" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="8">
    <TextBlock x:Name="Heading" Text="Reset password" Classes="h2" />
    <RadioButton x:Name="EmailChoice" GroupName="mode" IsChecked="True" Content="Email them a reset link" />
    <RadioButton x:Name="TempChoice" GroupName="mode" Content="Give them a temporary password (they must change it at sign-in)" />
    <RadioButton x:Name="CustomChoice" GroupName="mode" Content="Set a password I choose" />
    <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="New password (at least 6 characters)" IsEnabled="False" />
    <Border x:Name="ResultBox" Background="{StaticResource SuccessBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
      <StackPanel Spacing="4">
        <TextBlock x:Name="ResultText" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
        <TextBox x:Name="TempBox" IsReadOnly="True" FontFamily="Consolas, Menlo, monospace" IsVisible="False" />
      </StackPanel>
    </Border>
    <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="CloseButton" Content="Cancel" Click="OnCancel" />
      <Button x:Name="ResetButton" Classes="primary" Content="Reset password" IsDefault="True" Click="OnReset" Padding="20,9" />
    </StackPanel>
  </StackPanel>
</Window>
