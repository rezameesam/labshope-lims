<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.OutsourceDialog"
        Title="Send to external lab" Width="440" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="8">
    <TextBlock x:Name="Heading" Classes="h2" TextWrapping="Wrap" />
    <TextBlock Text="The cost is recorded in your accounts as an outsourcing expense owed to that lab." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" />
    <TextBlock Text="EXTERNAL LAB" Classes="label" />
    <ComboBox x:Name="LabBox" HorizontalAlignment="Stretch" />
    <TextBlock Text="COST CHARGED BY THAT LAB" Classes="label" Margin="0,6,0,0" />
    <TextBox x:Name="CostBox" />
    <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Classes="primary" Content="Send" IsDefault="True" Click="OnSend" Padding="22,9" />
    </StackPanel>
  </StackPanel>
</Window>
