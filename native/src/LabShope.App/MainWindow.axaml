<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.MainWindow"
        Title="LabShope LIMS" Width="1280" Height="800" MinWidth="960" MinHeight="600">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Sync now" HotKey="F9" Click="OnSync" />
        <Separator />
        <MenuItem Header="_Sign out" Click="OnSignOut" />
        <MenuItem Header="E_xit" HotKey="Alt+F4" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Work">
        <MenuItem Header="_Patients" HotKey="F2" Click="OnOpenPatients" />
        <MenuItem Header="_Bills" HotKey="F3" Click="OnOpenBills" />
        <MenuItem Header="Register _visit" HotKey="F4" Click="OnOpenRegister" />
        <MenuItem Header="Patient _tests and results" IsEnabled="False" />
        <MenuItem Header="Lab _sheets" IsEnabled="False" />
        <MenuItem Header="Booking _requests" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Catalog">
        <MenuItem Header="Test catalog" IsEnabled="False" />
        <MenuItem Header="Test packages" IsEnabled="False" />
        <MenuItem Header="Report templates" IsEnabled="False" />
        <MenuItem Header="Inventory" IsEnabled="False" />
        <MenuItem Header="Doctors" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Manage">
        <MenuItem Header="Employees" IsEnabled="False" />
        <MenuItem Header="Labs and collection centers" IsEnabled="False" />
        <MenuItem Header="External labs" IsEnabled="False" />
        <MenuItem Header="_Daily cash book" HotKey="F7" Click="OnOpenCashBook" />
        <MenuItem Header="Reports" IsEnabled="False" />
        <MenuItem Header="Finance" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4" Spacing="2">
      <Button Classes="tool" Content="Register visit (F4)" Click="OnOpenRegister" />
      <Button Classes="tool" Content="Patients (F2)" Click="OnOpenPatients" />
      <Button Classes="tool" Content="Bills (F3)" Click="OnOpenBills" />
      <Button Classes="tool" Content="Cash book (F7)" Click="OnOpenCashBook" />
      <Button Classes="tool" Content="Sync (F9)" Click="OnSync" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="#EEF1F5" BorderBrush="#C9CFD8" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel>
        <TextBlock x:Name="ClockText" DockPanel.Dock="Right" />
        <TextBlock x:Name="ScanText" DockPanel.Dock="Right" Margin="0,0,24,0" Foreground="#555" />
        <TextBlock x:Name="LabText" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,16,0" />
        <TextBlock x:Name="StatusText" Text="Ready" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Windows" Margin="4" />
  </DockPanel>
</Window>
