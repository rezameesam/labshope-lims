<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="LabShope.App.MainWindow"
        Icon="/Assets/icon.png"
        Title="LabShope LIMS" Width="1360" Height="860" MinWidth="1100" MinHeight="700">
  <Grid ColumnDefinitions="252,*">

    <!-- Sidebar -->
    <Border Background="{StaticResource NavyBrush}">
      <DockPanel Margin="14,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,6,6,26">
          <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
            <mi:MaterialIcon Kind="Flask" Width="22" Height="22" Foreground="White" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="LabShope" Foreground="White" FontSize="17" FontWeight="Bold" />
            <TextBlock x:Name="LabText" Foreground="#8FA8BB" FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,8,0,0">
          <Border Height="1" Background="#1AFFFFFF" Margin="6,0,6,10" />
          <UniformGrid Columns="3">
            <Button Classes="nav" Click="OnSync" ToolTip.Tip="Sync now (F9)" HorizontalContentAlignment="Center"><mi:MaterialIcon Kind="Sync" Width="20" Height="20" /></Button>
            <Button Classes="nav" Click="OnFullScreen" ToolTip.Tip="Full screen (F11)" HorizontalContentAlignment="Center"><mi:MaterialIcon Kind="Fullscreen" Width="20" Height="20" /></Button>
            <Button Classes="nav" Click="OnSignOut" ToolTip.Tip="Sign out" HorizontalContentAlignment="Center"><mi:MaterialIcon Kind="LogoutVariant" Width="20" Height="20" /></Button>
          </UniformGrid>
          <TextBlock x:Name="UserText" Foreground="#6F8AA0" FontSize="11" Margin="14,6,6,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavPanel" Spacing="4" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
        <DockPanel Margin="28,0" Height="68">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border x:Name="ScanChip" Classes="pill" Background="{StaticResource PrimaryLightBrush}" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Barcode" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="ScanText" Foreground="{StaticResource PrimaryBrush}" />
              </StackPanel>
            </Border>
            <Border x:Name="SyncChip" Classes="pill" Background="{StaticResource SuccessBgBrush}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse x:Name="SyncDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SyncText" Foreground="{StaticResource SuccessBrush}" Text="Starting…" />
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock x:Name="PageTitle" Classes="h1" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <ContentControl x:Name="Page" Grid.Row="1" Margin="28,24" />
    </Grid>
  </Grid>
</Window>
