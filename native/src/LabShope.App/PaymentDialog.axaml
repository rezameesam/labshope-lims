<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.PaymentDialog"
        Title="Receive payment" Width="420" Height="380" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="Summary" Foreground="#555" />
    <TextBlock Text="Amount" />
    <TextBox x:Name="AmountBox" />
    <TextBlock Text="Paid by" />
    <ComboBox x:Name="MethodBox" HorizontalAlignment="Stretch" SelectedIndex="0">
      <ComboBoxItem>cash</ComboBoxItem>
      <ComboBoxItem>upi</ComboBoxItem>
      <ComboBoxItem>card</ComboBoxItem>
      <ComboBoxItem>online</ComboBoxItem>
      <ComboBoxItem>bank_transfer</ComboBoxItem>
    </ComboBox>
    <TextBlock Text="Reference (UPI / card / transaction number, optional)" />
    <TextBox x:Name="RefBox" />
    <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Receive payment" IsDefault="True" Click="OnSave" Padding="16,6" />
    </StackPanel>
  </StackPanel>
</Window>
