<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.AccountDialog"
        Title="Account" Width="460" Height="420" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="8">
    <TextBlock x:Name="HeadText" Text="New account" Classes="h2" />
    <TextBox x:Name="CodeBox" Watermark="Code, for example 1004" />
    <TextBox x:Name="NameBox" Watermark="Account name" />
    <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" PlaceholderText="What kind of account" />
    <TextBox x:Name="DescriptionBox" Watermark="Description (optional)" />
    <Border x:Name="ErrorBox" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="12,10" IsVisible="False">
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="primary" Content="Save account" IsDefault="True" Click="OnSave" Padding="20,9" />
    </StackPanel>
  </StackPanel>
</Window>
