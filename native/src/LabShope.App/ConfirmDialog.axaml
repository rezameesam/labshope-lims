<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.ConfirmDialog"
        Title="Please confirm" Width="460" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="12">
    <TextBlock x:Name="Heading" Classes="h2" TextWrapping="Wrap" />
    <TextBlock x:Name="Detail" Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
      <Button x:Name="OkButton" Classes="primary" Click="OnOk" Padding="20,9" />
    </StackPanel>
  </StackPanel>
</Window>
