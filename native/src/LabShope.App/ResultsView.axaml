<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:LabShope.Core.Data"
             xmlns:app="using:LabShope.App"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="LabShope.App.ResultsView">
  <Grid ColumnDefinitions="*,18,430">
    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <ComboBox x:Name="FilterBox" SelectedIndex="0" Width="150">
          <ComboBoxItem>To do</ComboBoxItem>
          <ComboBoxItem>Completed</ComboBoxItem>
          <ComboBoxItem>All</ComboBoxItem>
        </ComboBox>
        <Grid ColumnDefinitions="Auto,*">
          <Border Background="White" BorderBrush="#C7D8E1" BorderThickness="1" CornerRadius="8" Grid.ColumnSpan="2" />
          <mi:MaterialIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" />
          <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Width="240" Watermark="Patient, ID or test" />
        </Grid>
        <TextBlock x:Name="CountText" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
      <DataGrid x:Name="Grid" x:DataType="data:WorklistRow" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="PATIENT" Binding="{Binding PatientLabel}" Width="*" MinWidth="170" />
          <DataGridTextColumn Header="TEST" Binding="{Binding TestLabel}" Width="170" />
          <DataGridTextColumn Header="RESULT" Binding="{Binding ResultText}" Width="90" />
          <DataGridTemplateColumn Header="STATUS" Width="96">
            <DataTemplate x:DataType="data:WorklistRow">
              <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{Binding Badge, Converter={x:Static app:Pills.Background}}">
                <TextBlock Text="{Binding Badge}" Foreground="{Binding Badge, Converter={x:Static app:Pills.Foreground}}" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <Border Grid.Column="2" Classes="card">
      <Grid>
        <!-- Nothing picked yet -->
        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="300">
          <mi:MaterialIcon Kind="TestTube" Width="44" Height="44" Foreground="#9CB4C4" HorizontalAlignment="Center" />
          <TextBlock Text="Pick a test from the list" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Type the result, press Enter, and the next test opens automatically." Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <DockPanel x:Name="FormPanel" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock x:Name="EntryHeading" Classes="h2" TextWrapping="Wrap" />
            <TextBlock x:Name="RangeText" Classes="muted" TextWrapping="Wrap" />
            <CheckBox x:Name="PanelToggle" Content="Several values (panel, e.g. CBC)" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
            <Button x:Name="SaveButton" Classes="primary" Content="Save result (Enter)" IsDefault="True" Click="OnSave" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button x:Name="OutsourceButton" Content="Send to an external lab…" Click="OnOutsource" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button x:Name="HistoryButton" Content="Who changed this result" Click="OnHistory" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button x:Name="ReportButton" Content="Print this patient's report" Click="OnPrintReport" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>

          <StackPanel x:Name="SinglePanel" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="RESULT" Classes="label" />
            <TextBox x:Name="ValueBox" />
            <TextBlock Text="UNIT" Classes="label" Margin="0,8,0,0" />
            <TextBox x:Name="UnitBox" />
            <CheckBox x:Name="AbnormalBox" Content="Mark as abnormal (when there is no numeric range)" Margin="0,8,0,0" />
          </StackPanel>

          <DockPanel x:Name="PanelPanel" IsVisible="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Bottom" Content="Add row" Click="OnAddRow" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <DataGrid x:Name="PanelGrid" x:DataType="app:PanelRow" AutoGenerateColumns="False" CanUserSortColumns="False" MinHeight="260">
              <DataGrid.Columns>
                <DataGridTextColumn Header="TEST" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="76" />
                <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="76" />
                <DataGridTextColumn Header="MIN" Binding="{Binding Min}" Width="62" />
                <DataGridTextColumn Header="MAX" Binding="{Binding Max}" Width="62" />
                <DataGridTemplateColumn Header="" Width="40">
                  <DataTemplate x:DataType="app:PanelRow">
                    <mi:MaterialIcon Kind="AlertCircle" Width="18" Height="18" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding Flag, Converter={x:Static app:Pills.Visible}}" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
