<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabShope.App.ReportOptionsDialog"
        Title="Print report" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="26" Spacing="10">
    <TextBlock Text="Print report options" Classes="h2" />
    <TextBlock Text="Turn all three off if you print on pre-printed letterhead paper. Your choice is remembered on this computer." Classes="muted" TextWrapping="Wrap" />
    <CheckBox x:Name="HeaderBox" Content="Header (lab name, logo and address)" />
    <CheckBox x:Name="FooterBox" Content="Footer (lab's closing text and note)" />
    <CheckBox x:Name="WatermarkBox" Content="Watermark (faint logo behind the results)" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Classes="primary" Content="Print" IsDefault="True" Click="OnPrint" Padding="20,9" />
    </StackPanel>
  </StackPanel>
</Window>
